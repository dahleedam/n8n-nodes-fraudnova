{
	"name": "n8n-nodes-fraudnova",
	"version": "0.1.0",
	"description": "FraudNova fraud scores for IP addresses, email addresses and phone numbers in n8n",
	"license": "MIT",
	"homepage": "https://fraudnova.com",
	"keywords": [
		"n8n-community-node-package"
	],
	"author": {
		"name": "FraudNova",
		"email": "dahleedam@gmail.com"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/dahleedam/n8n-nodes-fraudnova.git"
	},
	"scripts": {
		"build": "n8n-node build",
		"build:watch": "tsc --watch",
		"dev": "n8n-node dev",
		"lint": "n8n-node lint",
		"lint:fix": "n8n-node lint --fix",
		"release": "n8n-node release",
		"prepublishOnly": "n8n-node prerelease",
		"test": "vitest run"
	},
	"files": [
		"dist"
	],
	"n8n": {
		"n8nNodesApiVersion": 1,
		"strict": true,
		"credentials": [
			"dist/credentials/FraudNovaApi.credentials.js"
		],
		"nodes": [
			"dist/nodes/FraudNova/FraudNova.node.js"
		]
	},
	"devDependencies": {
		"@n8n/node-cli": "*",
		"eslint": "9.39.4",
		"prettier": "3.8.3",
		"release-it": "20.2.0",
		"typescript": "5.9.3",
		"vitest": "^3.2.4"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	}
}
